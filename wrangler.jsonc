{
  // Конфіг для деплою на Cloudflare. Проєкт створений як Worker зі статичними
  // ассетами, тож команда деплою — `npx wrangler deploy`, і вона шукає саме цей
  // файл. Без нього крок Deploying падає, хоча збірка проходить успішно.
  //
  // "name" мусить збігатися з іменем проєкту в дашборді Cloudflare.
  "name": "syndicate-clean",
  "compatibility_date": "2026-08-17",

  "assets": {
    // Куди Vite кладе зібраний сайт
    "directory": "./dist",

    // Кожна сторінка сайту має власний файл: dist/poslugy/index.html і т.д.
    // Їх генерує scripts/generate-seo.mjs — саме з них робот Google і
    // краулери месенджерів беруть заголовок, опис і картинку прев'ю.
    //
    // "drop-trailing-slash" означає: /poslugy віддається одразу, а /poslugy/
    // редіректиться на адресу без слеша. Це має збігатися з тим, що стоїть
    // у canonical (теж без слеша) — інакше кожна адреса з sitemap спершу
    // давала б редірект, а це зайвий крок для пошуковика.
    "html_handling": "drop-trailing-slash",

    // Невідома адреса віддає dist/404.html із чесним кодом 404.
    // Раніше тут стояв SPA-фолбек: будь-яке сміття в адресі повертало
    // головну з кодом 200, і Google бачив нескінченно багато копій
    // головної сторінки. Тепер фолбек не потрібен — усі справжні
    // сторінки лежать окремими файлами й відкриваються напряму.
    //
    // ⚠️ Через це нова сторінка сайту мусить мати запис у SEO
    // (src/config/site.js). Якщо забути — збірка попередить.
    "not_found_handling": "404-page"
  }
}
