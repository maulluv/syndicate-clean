# Заголовки кешування (Cloudflare читає цей файл із кореня сайту).
# Формат: шлях, а під ним із відступом — заголовки.
#
# Навіщо: за замовчуванням Cloudflare каже браузеру перепитувати КОЖЕН файл
# при кожному заході. Для HTML це правильно — інакше після деплою люди бачили б
# стару сторінку. Але для картинок і зібраних скриптів це зайві запити, і на
# мобільному інтернеті вони відчутні.

# Зібрані JS і CSS. У назві файлу є хеш (index-BCXDodWT.js), і при будь-якій
# зміні коду змінюється сама назва. Тобто цей конкретний файл не зміниться
# ніколи — його можна кешувати на рік і більше не питати про нього взагалі.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Фото. Назви постійні, тому «назавжди» не можна — інакше заміна фото не
# дійшла б до тих, хто вже був на сайті. Тиждень — розумний компроміс.
/hero/*
  Cache-Control: public, max-age=604800
/services/*
  Cache-Control: public, max-age=604800
/chemistry/*
  Cache-Control: public, max-age=604800

# Картинка прев'ю посилань — доба, щоб заміна розійшлась швидше
/og-cover.jpg
  Cache-Control: public, max-age=86400

# HTML навмисно НЕ чіпаємо: лишається перевірка при кожному заході, щоб
# після деплою всі одразу бачили нову версію сайту.
